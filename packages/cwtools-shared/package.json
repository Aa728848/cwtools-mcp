{
  "name": "cwtools-shared",
  "version": "0.6.0",
  "description": "Shared protocol and tool contracts for the CWTools MCP server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aa728848/cwtools-mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./editors": {
      "types": "./dist/editors/index.d.ts",
      "default": "./dist/editors/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test:contracts": "ts-mocha -p tsconfig.test.json \"src/test/**/*.test.ts\""
  }
}
{
  "name": "cwtools-node",
  "version": "0.2.0",
  "description": "Transport-agnostic CWTools Node host services (filesystem, LSP process, revalidation, project detection)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aa728848/cwtools-mcp.git"
  },
  "keywords": [
    "cwtools",
    "stellaris",
    "paradox",
    "language-server",
    "node"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "prebuild": "npm run build -w cwtools-shared",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test:contracts": "ts-mocha -p tsconfig.test.json --timeout 20000 \"src/test/**/*.test.ts\""
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "cwtools-shared": "0.3.0",
    "vscode-jsonrpc": "^8.2.0"
  }
}